{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recorded Route Map Data",
  "type": "object",
  "required": ["label", "static_feed_version", "route_id", "observation_window", "geometry", "stops", "trips"],
  "properties": {
    "label": {"const": "Recorded Historical Data — September 2026"},
    "static_feed_version": {"type": "string"},
    "route_id": {"type": "string", "minLength": 1},
    "observation_window": {
      "type": "object", "required": ["start", "end_exclusive"],
      "properties": {"start": {"type": "string"}, "end_exclusive": {"type": "string"}}
    },
    "geometry": {
      "type": "object", "required": ["type", "features"],
      "properties": {
        "type": {"const": "FeatureCollection"},
        "features": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/shapeFeature"}}
      }
    },
    "stops": {
      "type": "object", "required": ["type", "features"],
      "properties": {
        "type": {"const": "FeatureCollection"},
        "features": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stopFeature"}}
      }
    },
    "trips": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["trip_id", "route_id", "shape_id", "direction_id", "stops"],
        "properties": {
          "trip_id": {"type": "string"}, "route_id": {"type": "string"}, "shape_id": {"type": "string"},
          "direction_id": {"type": ["integer", "null"]},
          "stops": {"type": "array", "minItems": 1, "items": {
            "type": "object", "required": ["stop_id", "stop_sequence"],
            "properties": {"stop_id": {"type": "string"}, "stop_sequence": {"type": "integer", "minimum": 0}}
          }}
        }
      }
    }
  },
  "$defs": {
    "coordinate": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "prefixItems": [{"type": "number", "minimum": -180, "maximum": 180}, {"type": "number", "minimum": -90, "maximum": 90}]
    },
    "ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "shapeFeature": {
      "type": "object", "required": ["type", "id", "properties", "geometry"],
      "properties": {
        "type": {"const": "Feature"}, "id": {"type": "string"},
        "properties": {
          "type": "object", "required": ["route_id", "shape_id", "trip_ids", "direction_ids", "shape_pt_sequences"],
          "properties": {
            "route_id": {"type": "string"}, "shape_id": {"type": "string"},
            "trip_ids": {"$ref": "#/$defs/ids"},
            "direction_ids": {"type": "array", "items": {"type": "integer"}},
            "shape_pt_sequences": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}}
          }
        },
        "geometry": {
          "type": "object", "required": ["type", "coordinates"],
          "properties": {"type": {"const": "LineString"}, "coordinates": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/coordinate"}}}
        }
      }
    },
    "stopFeature": {
      "type": "object", "required": ["type", "id", "properties", "geometry"],
      "properties": {
        "type": {"const": "Feature"}, "id": {"type": "string"},
        "properties": {
          "type": "object", "required": ["stop_id", "stop_name", "stop_lat", "stop_lon", "route_ids", "trip_ids"],
          "properties": {
            "stop_id": {"type": "string"}, "stop_name": {"type": "string"},
            "stop_lat": {"type": "number", "minimum": -90, "maximum": 90},
            "stop_lon": {"type": "number", "minimum": -180, "maximum": 180},
            "route_ids": {"$ref": "#/$defs/ids"}, "trip_ids": {"$ref": "#/$defs/ids"}
          }
        },
        "geometry": {
          "type": "object", "required": ["type", "coordinates"],
          "properties": {"type": {"const": "Point"}, "coordinates": {"$ref": "#/$defs/coordinate"}}
        }
      }
    }
  }
}
