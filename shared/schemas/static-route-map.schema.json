{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Static Route Map Data",
  "type": "object",
  "required": [
    "label",
    "static_feed_version",
    "route_id",
    "observation_window",
    "geometry",
    "stops",
    "trips",
    "data_source",
    "historical_data_status",
    "route"
  ],
  "properties": {
    "label": {
      "const": "Static GTFS Network \u2014 no historical observations included"
    },
    "static_feed_version": {
      "type": "string"
    },
    "route_id": {
      "type": "string",
      "minLength": 1
    },
    "observation_window": {
      "type": "null"
    },
    "geometry": {
      "type": "object",
      "required": [
        "type",
        "features"
      ],
      "properties": {
        "type": {
          "const": "FeatureCollection"
        },
        "features": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/shapeFeature"
          }
        }
      }
    },
    "stops": {
      "type": "object",
      "required": [
        "type",
        "features"
      ],
      "properties": {
        "type": {
          "const": "FeatureCollection"
        },
        "features": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stopFeature"
          }
        }
      }
    },
    "trips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "trip_id",
          "route_id",
          "shape_id",
          "direction_id",
          "stops"
        ],
        "properties": {
          "trip_id": {
            "type": "string"
          },
          "route_id": {
            "type": "string"
          },
          "shape_id": {
            "type": "string"
          },
          "direction_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "stops": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "stop_id",
                "stop_sequence"
              ],
              "properties": {
                "stop_id": {
                  "type": "string"
                },
                "stop_sequence": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "data_source": {
      "const": "static_gtfs"
    },
    "historical_data_status": {
      "const": "not_included"
    },
    "route": {
      "type": "object",
      "required": [
        "route_id",
        "agency_id",
        "route_type"
      ]
    }
  },
  "$defs": {
    "coordinate": {
      "$ref": "recorded-route-map.schema.json#/$defs/coordinate"
    },
    "ids": {
      "$ref": "recorded-route-map.schema.json#/$defs/ids"
    },
    "shapeFeature": {
      "$ref": "recorded-route-map.schema.json#/$defs/shapeFeature"
    },
    "stopFeature": {
      "$ref": "recorded-route-map.schema.json#/$defs/stopFeature"
    }
  }
}
